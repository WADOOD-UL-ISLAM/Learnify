@model LearnifyD1.Models.StudentBatch
@{
    ViewData["Title"] = "Batch Fee Detail";

    var enrollmentId = $"{Model.batch.SpecialId}-{Model.student.StudentId}";
    var feeRecords = ViewBag.FeeRecords as List<LearnifyD1.Models.FeeRecord> ?? new List<LearnifyD1.Models.FeeRecord>();

    int totalPaid = feeRecords.Sum(f => f.AmountPaid);
    int totalFee = Model.batch.Course.Fees;
    int remaining = totalFee - totalPaid;
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between">
            <strong>Batch: @Model.batch.BatchName</strong>
            <span>Enrollment ID: @enrollmentId</span>
        </div>

        <div class="card-body">
            <h5>Student: @Model.student.StudentName</h5>
            <p class="text-muted">Course: @Model.batch.Course.CourseName</p>
            <p>Enrolled On: @Model.dateTime.ToShortDateString()</p>

            <hr />
            <h5 class="mb-2">Fee Summary</h5>
            <p><strong>Total Fee:</strong> Rs. @totalFee.ToString("N0")</p>
            <p><strong>Total Paid:</strong> Rs. @totalPaid.ToString("N0")</p>
            <p><strong>Remaining:</strong> Rs. @remaining.ToString("N0")</p>

            @if (feeRecords.Any())
            {
                <h6 class="mt-4">Previous Payments</h6>
                <table class="table table-bordered table-sm">
                    <thead>
                        <tr>
                            <th>Payment Date</th>
                            <th>Amount Paid</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fee in feeRecords)
                        {
                            <tr>
                                <td>@fee.PaymentDate.ToShortDateString()</td>
                                <td>Rs. @fee.AmountPaid.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <form asp-action="AddFeePayment" method="post" class="row g-3 mt-3">
                <input type="hidden" name="StudentId" value="@Model.StudentId" />
                <input type="hidden" name="BatchId" value="@Model.BatchId" />

                <div class="col-md-5">
                    <label class="form-label">Payment Date</label>
                    <input type="date" name="PaymentDate" class="form-control" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label">Amount Paid</label>
                    <input type="number" name="AmountPaid" class="form-control" min="1" required />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Add</button>
                </div>
            </form>

            <a asp-action="ShowReceipt"
               asp-route-studentId="@Model.StudentId"
               asp-route-batchId="@Model.BatchId"
               class="btn btn-outline-secondary mt-3">
                View Receipt
            </a>
        </div>
    </div>
</div>
