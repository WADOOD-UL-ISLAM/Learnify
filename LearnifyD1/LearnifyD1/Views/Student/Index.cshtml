@model IEnumerable<LearnifyD1.Models.Student>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0"><i class="fas fa-users me-2"></i>Enrollments</h3>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Student Name</th>
                            <th>Email</th>
                            <th>Enrolled Batches</th>
                            <th>Courses</th>
                            <th>Actions</th>
                            <th>Picture</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td class="fw-semibold" >
                                    <a asp-action="Details"
                                       asp-controller="Student"
                                       asp-route-id="@student.StudentId">
                                       @student.StudentName
                                   </a>
                                </td>
                                <td>
                                    <a href="mailto:@student.StudentEmail" class="text-decoration-none">
                                        @student.StudentEmail
                                    </a>
                                </td>
                                <td>
                                    @if (student.studentBatches.Any())
                                    {
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button"
                                                    id="dropdownBatches-@student.StudentId" data-bs-toggle="dropdown"
                                                    aria-expanded="false">
                                                @student.studentBatches.Count() Batch(es)
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="dropdownBatches-@student.StudentId">
                                                @foreach (var enrollment in student.studentBatches)
                                                {
                                                    <li class="dropdown-item">
                                                        @enrollment.batch.BatchName
                                                        <span class="text-muted ms-2">(@enrollment.dateTime.ToString("d"))</span>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Not enrolled</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var courses = student.studentBatches
                                        .Select(sb => sb.batch.Course.CourseName)
                                        .Distinct()
                                        .ToList();
                                    }
                                    @if (courses.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var course in courses)
                                            {
                                                <span class="badge bg-info text-dark">@course</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">None</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(student.ImagePath))
                                    {
                                        <img src="@student.ImagePath" alt="Student Image" class="img-thumbnail" style="width: 60px; height: 60px;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">No Image</span>
                                    }
                                </td>

                                
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Edit" asp-controller="Student" asp-route-id="@student.StudentId"
                                           class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-controller="Student" asp-route-id="@student.StudentId"
                                           class="btn btn-outline-primary" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                       
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-light">
            <div class="d-flex justify-content-between align-items-center">
                <div class="text-muted">
                    Total: @Model.Count() students
                </div>
                <div>
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1">Previous</a>
                            </li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">3</a></li>
                            <li class="page-item">
                                <a class="page-link" href="#">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>