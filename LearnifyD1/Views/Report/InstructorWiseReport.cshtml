@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Instructor-wise Reporting";
}

<h3 class="mb-4">🧑‍🏫 Instructor-wise Batch Assignment Report</h3>

@foreach (var instructor in Model)
{
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <strong>@instructor.InstructorName</strong> | Role: @instructor.Role
        </div>
        <div class="card-body p-0">
            <table class="table table-bordered m-0">
                <thead class="table-light">
                    <tr>
                        <th>Batch Name</th>
                        <th>Total Students</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var batch in instructor.AssignedBatches)
                    {
                        <tr>
                            <td>@batch.BatchName</td>
                            <td>@batch.TotalStudents</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
