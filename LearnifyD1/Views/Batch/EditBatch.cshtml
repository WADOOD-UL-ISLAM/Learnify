
@model Batch

<h1>Edit batch</h1>
<form asp-action="EditBatch" method="post">

    <input asp-for="BatchId" type="hidden" />
    <div class="form-group">
        <label asp-for="BatchName">Batch Name</label>
        <input  class="form-control" asp-for="BatchName" />
    </div>

    <div class="form-group">
        <label asp-for="time">Time</label>
        <input type="datetime-local" class="form-control" asp-for="time" />
    </div>

    <div class="form-group">
        <label asp-for="Slots">Slots</label>
        <input type="number" asp-for="Slots" class="form-control" />
    </div>

    <div class="form-group">
        <label>Courses</label>
        <select name="CourseId" asp-for="CourseId" asp-items="ViewBag.Courses" class="form-control">
            <option value="" >-- Select Course --</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Enroll Student</button>
</form>