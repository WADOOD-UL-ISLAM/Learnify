@model List<Batch>
@{
    ViewBag.Title = "Batch Courses";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Batches </h2>
        <a asp-action="CreateNewBatch" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Create a Batch
        </a>
    </div>

    <!-- Filter Section -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title">Filter by Course</h5>
            <form asp-controller="Batch" asp-action="ChangeCourse" method="get" id="courseForm">
                <div class="mb-3">
                    <label for="courseSelect" class="form-label fw-bold"></label>
                    <select class="form-select" id="courseSelect" name="CourseId">
                        <option value=""> Select a Course </option>
                        @foreach (Course course in ViewBag.Courses)
                        {
                            <option value="@course.CourseId" selected="@(ViewBag.SelectedCourse == course.CourseId)">
                                @course.CourseName
                            </option>
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>

    <!-- Batch List Table -->
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Special ID</th>
                    <th>Days</th>
                    <th>Timing</th>
                    <th>Months</th>
                    <th>Slots</th>
                    <th>Fees</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Any())
                {
                    @foreach (var batch in Model)
                    {
                        <tr>
                            <td>@batch.SpecialId</td>
                            <td>@batch.BatchDays</td>
                            <td>
                                @batch.StartTime.ToString("hh\\:mm tt") -
                                @batch.EndTime.ToString("hh\\:mm tt")
                            </td>
                            <td>
                                @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(batch.StartMonth)
                                -
                                @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(batch.EndMonth)
                            </td>
                            <td>@batch.Slots</td>
                            <td>Rs. @batch.Course.Fees.ToString("N0")</td>
                            <td>
                                <a class="btn btn-warning btn-sm"
                                   asp-action="EditBatch"
                                   asp-controller="Batch"
                                   asp-route-id="@batch.BatchId">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a class="btn btn-danger btn-sm"
                                   asp-action="Delete"
                                   asp-controller="Batch"
                                   asp-route-id="@batch.BatchId"
                                   onclick="return confirm('Are you sure you want to delete this batch?');">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">No batches found.</td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>

<!-- JavaScript -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.getElementById('courseSelect').addEventListener('change', function () {
                document.getElementById('courseForm').submit();
            });
        });
    </script>
}
