@model IEnumerable<LearnifyD1.Models.Role>

<div class="container mt-4">
    <h3 class="text-primary mb-3">All Roles</h3>
    <a asp-action="Create" class="btn btn-success mb-3">Add New Role</a>

    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Role Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in Model)
            {
                <tr>
                    <td>@role.RoleId</td>
                    <td>@role.RoleName</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@role.RoleId" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@role.RoleId" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
