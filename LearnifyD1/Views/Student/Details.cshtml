@model LearnifyD1.Models.Student
@{
    ViewData["Title"] = "Student Details";
    int totalFee = 0;
}

<div class="container mt-4">
    <div class="row align-items-center mb-4">
        <div class="col-md-8">
            
            <h2>@Model.StudentName</h2>
            <p class="text-muted mb-0">@Model.StudentEmail</p>
           <p><strong>Student ID:</strong> @Model.UniqueId</p>
        </div>
        <div class="col-md-4 text-end">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@Model.ImagePath" alt="Student Image" class="img-thumbnail shadow" style="max-height: 150px;" />
            }
            else
            {
                <span class="text-muted">No Image Uploaded</span>
            }
        </div>
    </div>

    <hr />

    <h4>Enrolled Batches</h4>
    @if (Model.studentBatches.Any())
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-light">
                <tr>
                    <th>Batch</th>
                    <th>Course</th>
                    <th>Fee</th>
                    <th>Enrolled On</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sb in Model.studentBatches)
                {
                    var course = sb.batch.Course;
                    totalFee += course.Fees;
                    <tr>
                        <td>@sb.batch.BatchName</td>
                        <td>@course.CourseName</td>
                        <td>Rs. @course.Fees.ToString("N0")</td>
                        <td>@sb.dateTime.ToShortDateString()</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary"
                               asp-action="BatchDetail"
                               asp-route-studentId="@Model.StudentId"
                               asp-route-batchId="@sb.BatchId">
                                View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="alert alert-info fw-bold">
            Total Fee: Rs. @totalFee.ToString("N0")
        </div>
    }
    else
    {
        <p class="text-muted">This student is not enrolled in any batches.</p>
    }
</div>
