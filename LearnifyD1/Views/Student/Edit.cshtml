@model LearnifyD1.Models.Student
@{
    ViewData["Title"] = "Edit Student";
    var selectedBatches = ViewBag.SelectedBatches as List<int> ?? new List<int>();
    var batches = ViewBag.Batches as List<LearnifyD1.Models.Batch> ?? new List<LearnifyD1.Models.Batch>();
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h3>Edit Student</h3>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger"></div>

                <input type="hidden" asp-for="StudentId" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="StudentName" class="form-label">Student Name</label>
                            <input asp-for="StudentName" class="form-control" />
                            <span asp-validation-for="StudentName" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="StudentEmail" class="form-label">Email</label>
                            <input asp-for="StudentEmail" class="form-control" />
                            <span asp-validation-for="StudentEmail" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ImageFile" class="form-label">Upload New Image</label>
                            <input asp-for="ImageFile" type="file" class="form-control" />
                            <span asp-validation-for="ImageFile" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6 text-end">
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <label>Current Image:</label>
                            <img src="@Model.ImagePath" class="img-thumbnail" style="max-height: 150px;" />
                        }
                        else
                        {
                            <p class="text-muted">No image uploaded</p>
                        }
                    </div>
                </div>

                <hr />

                <div class="mt-4">
                    <h5>Enrolled Batches</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Course</th>
                                    <th>Batch</th>
                                    <th>Time</th>
                                    <th>Select</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var group in batches.GroupBy(b => b.Course))
                                {
                                    <tr class="table-info">
                                        <td colspan="4"><strong>@group.Key.CourseName</strong></td>
                                    </tr>
                                    @foreach (var batch in group)
                                    {
                                        <tr>
                                            <td></td>
                                            <td>@batch.BatchName</td>
                                            <td>@batch.time.ToString("g")</td>
                                            <td>
                                                <input type="checkbox"
                                                       name="selectedBatches"
                                                       value="@batch.BatchId"
                                                       @(selectedBatches.Contains(batch.BatchId) ? "checked" : "") />
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-success">Update</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
