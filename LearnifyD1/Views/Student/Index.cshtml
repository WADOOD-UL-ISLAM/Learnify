@model IEnumerable<LearnifyD1.Models.Student>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="fas fa-users text-primary me-2"></i>Student Enrollments
        </h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-circle me-1"></i> Add New Student
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0"><i class="fas fa-list-alt me-2"></i>Student Records</h3>
            <div class="search-box">
                <form asp-action="Index" method="get" class="d-flex">
                    <div class="input-group">
                        <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control form-control-sm" placeholder="Search students..." />

                        <button type="submit" class="btn btn-sm btn-light">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Student Name</th>
                            <th>Email</th>
                            <th>Enrolled Batches</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(student.ImagePath))
                                        {
                                            <div class="avatar me-3">
                                                <img src="@student.ImagePath" alt="@student.StudentName" class="rounded-circle" style="width:40px; height:40px; object-fit:cover;">
                                            </div>
                                        }
                                        <div>
                                            <a asp-action="Details" asp-controller="Student" asp-route-id="@student.StudentId" class="text-decoration-none">
                                                @student.StudentName
                                            </a>
                                            @if (student.studentBatches.Any())
                                            {
                                                <div class="text-muted small mt-1">
                                                    Batch: @student.studentBatches.First().batch.BatchName
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <a href="mailto:@student.StudentEmail" class="text-decoration-none d-inline-block text-truncate" style="max-width: 200px;">
                                        @student.StudentEmail
                                    </a>
                                </td>

                                <td>
                                    @if (student.studentBatches.Any())
                                    {
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button"
                                                    id="dropdownBatches-@student.StudentId" data-bs-toggle="dropdown"
                                                    aria-expanded="false">
                                                @student.studentBatches.Count() Batch(es)
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="dropdownBatches-@student.StudentId">
                                                @foreach (var enrollment in student.studentBatches)
                                                {
                                                    <li class="dropdown-item d-flex justify-content-between">
                                                        <span>@enrollment.batch.BatchName</span>
                                                        <small class="text-muted">@enrollment.dateTime.ToString("d")</small>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Not enrolled</span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-action="AdmissionFormPreview" asp-route-id="@student.StudentId" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-eye"></i> Form Preview
                                        </a>
                                        <a asp-action="Edit" asp-controller="Student" asp-route-id="@student.StudentId"
                                           class="btn btn-sm btn-outline-primary" title="Edit" data-bs-toggle="tooltip">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-controller="Student" asp-route-id="@student.StudentId"
                                           class="btn btn-sm btn-outline-info" title="Details" data-bs-toggle="tooltip">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-controller="Student" asp-route-id="@student.StudentId"
                                           class="btn btn-sm btn-outline-danger" title="Delete" data-bs-toggle="tooltip">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-light">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted">Showing <strong>@Model.Count()</strong> of @ViewBag.TotalStudents students</span>

                </div>
                <div>
                    <nav aria-label="Page navigation">
                        @{
                            int currentPage = ViewBag.CurrentPage as int? ?? 1;
                            int pageSize = ViewBag.PageSize as int? ?? 10;
                            int totalStudents = ViewBag.TotalStudents as int? ?? 0;
                            int totalPages = (int)Math.Ceiling(totalStudents / (double)pageSize);
                        }

                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@ViewBag.SearchString">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>

                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewBag.SearchString">@i</a>
                                </li>
                            }

                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchString="@ViewBag.SearchString">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>

                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Enable tooltips
        $(document).ready(function(){
            $('[data-bs-toggle="tooltip"]').tooltip();
        });
    </script>
}