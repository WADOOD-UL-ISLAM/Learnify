@model LearnifyD1.Models.Student
@{
    ViewData["Title"] = "Admission Form";
    var today = DateTime.Today.ToString("dd-MM-yyyy");
}


<style>

     
   
    .form-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    .form-header {
        text-align: center;
        margin-bottom: 20px;
    }

    .logo-container {
        height: 80px;
        margin-bottom: 10px;
    }

    .academy-logo {
        height: 100%;
        max-width: 200px;
        object-fit: contain;
    }

    .form-title {
        color: #2c3e50;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 5px;
    }

    .form-subtitle {
        color: #e74c3c;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .contact-info {
        font-size: 0.9rem;
        margin-bottom: 15px;
    }

    .section-title {
        background-color: #f8f9fa;
        padding: 5px 10px;
        font-weight: 600;
        margin: 15px 0 10px 0;
        border-left: 4px solid #3498db;
    }

    .form-label {
        font-weight: 500;
        margin-bottom: 3px;
        font-size: 0.9rem;
    }

    .form-control {
        border-radius: 3px;
    }

    .declaration-box {
        border: 1px solid #ddd;
        padding: 15px;
        background-color: #f9f9f9;
        font-size: 0.85rem;
        line-height: 1.4;
    }

    .signature-area {
        margin-top: 30px;
    }

    .photo-upload {
        border: 2px dashed #ccc;
        padding: 10px;
        text-align: center;
        border-radius: 5px;
        background-color: #f8f9fa;
    }


    @@media print {
        .no-print {
            display: none;
        }

        .print-only {
            display: block;
        }

        body {
            background-color: white;
            color: black;
        }

        .card {
            border: none;
            box-shadow: none;
        }

        .container {
            max-width: 100%;
            padding: 0;
        }
         body {
            background: white;
            color: black;
            font-size: 11px;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }

        .form-container {
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 auto !important;
        }

        .no-print {
            display: none !important;
        }

        .print-only {
            display: flex !important;
        }

        .container, .row, .col-md-6, .col-md-4, .col-md-3 {
            break-inside: avoid !important;
            page-break-inside: avoid !important;
        }

        html, body {
            width: 210mm;
            height: 297mm;
            margin: 0;
            padding: 0;
        }

       
    }


</style>

<div class="container form-container print-only " style="page-break-inside: avoid;">
    <div class="card shadow-sm">
        <div class="card-body p-4">

            <!-- Form Header with Logo -->
            <div class="form-header">
                <div class="logo-container">
                    <img src="~/images/assets/logo.png" alt="Learnify Academy Logo" class="academy-logo" />
                </div>
                <h3 class="form-title">LEARNING ACADEMY</h3>
                <h5 class="form-subtitle">Ab Hoga Upskill Pakistan</h5>
                <div class="contact-info">
                    <div>Area 36-D, House No:6/7, Landhi No:05</div>
                    <div>📞 0346 2309242, 0330 8531573</div>
                    <div>LearnifyAcademy</div>
                </div>
            </div>

            <!-- Form Title -->
            <div class="text-center mb-4">
                <h4 class="text-uppercase" style="border-bottom: 2px solid #3498db; display: inline-block; padding-bottom: 5px;">
                    Admission Form
                </h4>
                <div class="mt-2">
                    <small class="text-muted">Registration #: LF-@DateTime.Now.ToString("yyyyMMddHHmmss")</small>
                </div>
            </div>

            <form asp-action="AdmissionForm" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <!-- Personal Information Section -->
                <div class="mb-4">
                    <div class="section-title">PERSONAL INFORMATION</div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Student Name</label>
                            <input asp-for="StudentName" class="form-control" placeholder="Enter full name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Father Name</label>
                            <input asp-for="FatherName" class="form-control" placeholder="Enter father's name" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">CNIC</label>
                            <input asp-for="CNIC" class="form-control" placeholder="XXXXX-XXXXXXX-X" />
                            <span asp-validation-for="CNIC" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Date of Birth</label>
                            <input asp-for="DateofBirth" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Gender</label>
                            <div class="d-flex">
                                <div class="form-check me-3">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="Male" id="male">
                                    <label class="form-check-label" for="male">Male</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="Female" id="female">
                                    <label class="form-check-label" for="female">Female</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Age</label>
                            <input asp-for="age" type="number" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Student Mobile #</label>
                            <input asp-for="StudentMobileNumber" class="form-control" placeholder="03XX-XXXXXXX" />
                        </div>
                    </div>
                </div>

                <!-- Contact Information Section -->
                <div class="mb-4">
                    <div class="section-title">CONTACT INFORMATION</div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Email Address</label>
                            <input asp-for="StudentEmail" class="form-control" placeholder="example@email.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Father's Mobile #</label>
                            <input asp-for="GuardianMobileNumber" class="form-control" placeholder="03XX-XXXXXXX" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Residential Address</label>
                        <textarea asp-for="Address" class="form-control" rows="3" placeholder="Full address with area code"></textarea>
                    </div>
                </div>

                <!-- Reference Section -->
                <div class="mb-4">
                    <div class="section-title">HOW DID YOU HEAR ABOUT US?</div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="HeardFrom" value="Facebook" id="facebook">
                                <label class="form-check-label" for="facebook">Facebook</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="HeardFrom" value="Instagram" id="instagram">
                                <label class="form-check-label" for="instagram">Instagram</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="HeardFrom" value="Friends" id="friends">
                                <label class="form-check-label" for="friends">Friends</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="HeardFrom" value="Other" id="other">
                                <label class="form-check-label" for="other">Other</label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Photo Upload Section -->
                <div class="mb-4 no-print">
                    <div class="section-title">STUDENT PHOTOGRAPH</div>
                    <div class="photo-upload">
                        <div class="mb-2">
                            <i class="bi bi-camera" style="font-size: 24px;"></i>
                        </div>
                        <label class="form-label">Recent Passport Size Color Photograph</label>
                        <input asp-for="ImageFile" type="file" class="form-control mt-2" accept="image/*" />
                        <small class="text-muted">(Max size: 2MB, JPG/PNG format)</small>
                    </div>
                </div>

                <!-- Declaration Section -->
                <div class="mb-4">
                    <div class="section-title">DECLARATION</div>
                    <div class="declaration-box">
                        <p>
                            I hereby declare that the information furnished in this form is true to the best of my knowledge and belief.
                            I acknowledge that the institute is not responsible for loss/damage to personal gadgets brought to institute.
                        </p>
                        <div class="form-check mt-3">
                            <input class="form-check-input" type="checkbox" id="declarationCheck" required>
                            <label class="form-check-label" for="declarationCheck">I agree to the above declaration</label>
                        </div>
                    </div>
                </div>

                <!-- Signature Section -->
                <div class="signature-area">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Student Signature</label>
                                <div class="signature-line" style="height: 50px;"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3 text-end">
                                <label class="form-label">Date: @today</label>
                                <div class="signature-line" style="height: 50px;"></div>
                                <small class="text-muted">(Office Stamp)</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Submit Button (hidden when printing) -->
                <div class="text-center no-print mt-4">
                    <button type="submit" class="btn btn-primary px-4 py-2">
                        <i class="bi bi-send-fill me-2"></i>Submit Admission Form
                    </button>
                    <button type="button" class="btn btn-outline-secondary px-4 py-2 ms-2" onclick="window.print()">
                        <i class="bi bi-printer-fill me-2"></i>Print Form
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Auto-format CNIC input
        document.getElementById('CNIC').addEventListener('input', function(e) {
            var value = e.target.value.replace(/\D/g, '');
            if (value.length > 5) {
                value = value.substring(0, 5) + '-' + value.substring(5);
            }
            if (value.length > 13) {
                value = value.substring(0, 13) + '-' + value.substring(13);
            }
            e.target.value = value.substring(0, 15);
        });

        // Auto-format phone numbers
        function formatPhoneNumber(input) {
            var value = input.value.replace(/\D/g, '');
            if (value.length > 4) {
                value = value.substring(0, 4) + '-' + value.substring(4);
            }
            input.value = value.substring(0, 12);
        }

        document.getElementById('StudentMobileNumber').addEventListener('input', function(e) {
            formatPhoneNumber(e.target);
        });

        document.getElementById('GuardianMobileNumber').addEventListener('input', function(e) {
            formatPhoneNumber(e.target);
        });
    </script>
}