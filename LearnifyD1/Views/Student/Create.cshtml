@model Student
@{
    ViewData["Title"] = "Create Student";
}

<div class="container mt-4">    
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h3>Create New Student</h3>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">

                <div class="row mt-4">
                    <div class="col-12">
                        <h4>Available Courses and Batches</h4>
                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>Course</th>
                                        <th>Batch Name</th>
                                        <th>Time</th>
                                        <th>Fees</th>
                                        <th>Enroll</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var batchesByCourse = ((IEnumerable<Batch>)ViewBag.Batches)
                                            .GroupBy(b => b.Course)
                                            .OrderBy(g => g.Key.CourseName);
                                    }
                                    
                                    @foreach (var courseGroup in batchesByCourse)
                                    {
                                        <tr class="table-info">
                                            <td colspan="5">
                                                <strong>@courseGroup.Key.CourseName</strong>
                                            </td>
                                        </tr>
                                        
                                        @foreach (var batch in courseGroup.OrderBy(b => b.time))
                                        {
                                            <tr>
                                                <td></td>
                                                <td>@batch.BatchName</td>
                                                <td>@batch.time.ToString("g")</td>
                                               
                                                <td class="text-center">
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input"
                                                               type="checkbox"
                                                               name="selectedBatches"
                                                               value="@batch.BatchId"
                                                               id="batch_@batch.BatchId" />
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    
                                    @if (!batchesByCourse.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="text-muted">No batches available</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

